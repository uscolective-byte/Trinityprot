export const validateActionAgainstConstitution = (action: string) => {
    const forbidden = ["rm -rf", "drop database"];
    if (forbidden.some(b => action.toLowerCase().includes(b))) return { allowed: false, reason: "Banned operation." };
    return { allowed: true };
};
''',

    "core/orchestrator.ts": r'''
import { validateActionAgainstConstitution } from "./constitution";

export class TrinityOrchestrator {
    public async executeTask(userGoal: string) {
        const safety = validateActionAgainstConstitution(userGoal);
        if (!safety.allowed) return { success: false, finalAnswer: safety.reason };

        const res = await fetch("http://localhost:8000/api/execute", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ prompt: userGoal })
        });
        const data = await res.json();
        return { success: true, finalAnswer: data.result, steps: [{ stepNumber: 1, thought: "Orchestrating..." }] };
    }
}
''',

